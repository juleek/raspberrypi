[Unit]
Description=reverse ssh tunnel swiss
Requires=network-online.target
After=network-online.target


[Service]
Type=simple
User=pi
ExecStart=/usr/bin/ssh -v -N -R localhost:32003:localhost:22 device_tarpi@83.228.240.210 -o ExitOnForwardFailure=yes -o ServerAliveInterval=1 -o ServerAliveCountMax=2 -o StrictHostKeyChecking=no -o UserKnownHostsFile=/dev/null
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target

